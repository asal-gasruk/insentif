<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mode A — Reverse proxy ke PM2/next start (port 3000).
  Prasyarat: URL Rewrite + ARR 3.0, ARR proxy enabled.
  Physical path site IIS: folder ini saja (deploy/iis) ATAU folder khusus berisi web.config ini.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="false" />
    <directoryBrowse enabled="false" />
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNextJS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
