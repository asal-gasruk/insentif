{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "dev:fresh": "npm run reset && npm run dev",
    "reset": "sh -c 'lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf .next node_modules/.cache; echo Cache .next dibersihkan.'",
    "prebuild": "node scripts/prebuild-check.mjs",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:sfa": "python3 scripts/generate-sfa-excel-json.py",
    "generate:hierarchy": "python3 scripts/generate-sfa-hierarchy.py",
    "generate:targets": "python3 scripts/generate-parameter-targets.py",
    "verify:sfa": "node scripts/verify-sfa-mapping.mjs",
    "verify:hierarchy": "node scripts/verify-sfa-hierarchy.mjs",
    "verify:rollup": "npx --yes tsx --tsconfig tsconfig.json scripts/verify-org-rollup.ts",
    "verify:output": "npx --yes tsx --tsconfig tsconfig.json scripts/verify-output-insentif.ts",
    "verify:targets": "node scripts/verify-parameter-targets.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
